# Application
APP_NAME=keystone-backend
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:///./keystone.db

# CORS (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Agent execution defaults ---
KEYSTONE_AGENT_DEFAULT_TIMEOUT_SECONDS=60
KEYSTONE_AGENT_MAX_PROMPT_CHARACTERS=20000
KEYSTONE_AGENT_MAX_OUTPUT_CHARACTERS=50000

# --- Retry ---
KEYSTONE_RETRY_BASE_DELAY_SECONDS=0.5
KEYSTONE_RETRY_MAX_DELAY_SECONDS=5
KEYSTONE_RETRY_JITTER_RATIO=0.1

# --- Circuit breaker ---
KEYSTONE_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
KEYSTONE_CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECONDS=30

# --- Claude Code (local `claude` CLI; uses its own existing authenticated session) ---
# Verified locally (Phase 6A.1): `claude --version` (2.1.154), `claude auth
# status`, a direct headless `-p ... --output-format json` call, and a real
# Keystone workflow execution all succeeded end to end. The prompt is sent via
# stdin, not a trailing CLI argument: on Windows `claude` resolves to an npm
# `.CMD` batch shim, and Windows routes `.cmd`/`.bat` targets through cmd.exe's
# own argument re-parsing, which reliably corrupts a multi-line CLI argument
# (every real prompt this app builds contains embedded newlines) — this was
# caught by this phase's live workflow smoke test before being fixed. Still
# disabled by default here (opt-in) — enabling requires the operator's own
# machine to already have `claude auth login` completed; Keystone itself never
# performs that login.
KEYSTONE_CLAUDE_CODE_ENABLED=false
KEYSTONE_CLAUDE_CODE_EXECUTABLE=claude
KEYSTONE_CLAUDE_CODE_ARGUMENTS=["-p","--output-format","json"]
KEYSTONE_CLAUDE_CODE_INPUT_MODE=stdin
KEYSTONE_CLAUDE_CODE_OUTPUT_MODE=json
# KEYSTONE_CLAUDE_CODE_TIMEOUT_SECONDS=300

# --- Codex (local `codex` CLI; uses its own existing authenticated session) ---
# Not installed in the environment this adapter was built in — the JSONL
# event-stream parser and `codex login status` check are modeled on Codex's
# publicly documented `exec --json` conventions, not captured from a live
# run. Verify `codex exec --help` yourself, confirm the arguments below still
# match your installed version, and enable explicitly before use.
KEYSTONE_CODEX_ENABLED=false
KEYSTONE_CODEX_EXECUTABLE=codex
KEYSTONE_CODEX_ARGUMENTS=["exec","--json","{prompt}"]
KEYSTONE_CODEX_INPUT_MODE=prompt_argument
KEYSTONE_CODEX_OUTPUT_MODE=json_lines
# KEYSTONE_CODEX_TIMEOUT_SECONDS=300

# --- Gemini (the official, standalone Gemini CLI; distinct from Google
# Antigravity below) ---
# Not installed in this environment: disabled by default with no default
# arguments. Reserved as a separate, still-unconfigured future provider —
# never an alias for `agy`/Antigravity. Verify `gemini --help` yourself, set
# real arguments, and enable explicitly before use.
KEYSTONE_GEMINI_ENABLED=false
KEYSTONE_GEMINI_EXECUTABLE=gemini
KEYSTONE_GEMINI_ARGUMENTS=[]
KEYSTONE_GEMINI_INPUT_MODE=stdin
KEYSTONE_GEMINI_OUTPUT_MODE=text
# KEYSTONE_GEMINI_TIMEOUT_SECONDS=60

# --- Google Antigravity (local `agy` CLI; a separate, Gemini-powered local
# coding agent — never call its executable "gemini") ---
# Not installed in the environment this adapter was built in — the JSON
# output parser is modeled on the same envelope convention as the other
# local-CLI adapters, not captured from a live run. Defaults to stdin input
# for the same reason as Claude Code above (a Windows npm `.cmd` shim's
# cmd.exe argument re-parsing corrupts multi-line CLI-argument prompts).
# Verify `agy --help` yourself, confirm the arguments below still match your
# installed version, and enable explicitly before use.
KEYSTONE_ANTIGRAVITY_ENABLED=false
KEYSTONE_ANTIGRAVITY_EXECUTABLE=agy
KEYSTONE_ANTIGRAVITY_ARGUMENTS=["-p","--output-format","json"]
KEYSTONE_ANTIGRAVITY_INPUT_MODE=stdin
KEYSTONE_ANTIGRAVITY_OUTPUT_MODE=json
# KEYSTONE_ANTIGRAVITY_TIMEOUT_SECONDS=300

# --- Demo adapter (no subprocess, no network; safe for local frontend demos) ---
KEYSTONE_DEMO_ENABLED=false

# --- Live agent connection verification ---
# The directory a future, explicitly-trusted feature could confine an
# agent's working directory to; today no workflow payload can set a working
# directory at all, so this is a defense-in-depth boundary, not yet load-bearing.
KEYSTONE_AGENT_WORKSPACE_ROOT=.
# How long POST /agents/{agent_type}/verify's result is cached before
# GET /agents will report it as requiring re-verification again.
KEYSTONE_AGENT_CONNECTION_CACHE_SECONDS=60

# --- Compensation ---
# When true, a workflow that reaches FAILED (other than from an unexpected
# internal error) is automatically compensated in reverse order immediately
# afterward, using the same CompensationService the manual compensate API
# uses. Off by default; manual compensation via
# POST /api/v1/workflows/{id}/compensate is always available regardless.
KEYSTONE_AUTO_COMPENSATE_ON_FAILURE=false
