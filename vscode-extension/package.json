{
  "name": "keystone-vscode-extension",
  "displayName": "Keystone AI Orchestrator",
  "description": "Keystone AI Agent Orchestration Platform - VS Code Extension Foundation",
  "version": "0.1.1",
  "publisher": "keystone-ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nikhil6750/Keystone.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:keystone.openWorkspace",
    "onView:keystone.sidebarView"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "keystone-activitybar",
          "title": "Keystone",
          "icon": "$(layers)"
        }
      ]
    },
    "views": {
      "keystone-activitybar": [
        {
          "type": "webview",
          "id": "keystone.sidebarView",
          "name": "Keystone Explorer"
        }
      ]
    },
    "commands": [
      {
        "command": "keystone.openWorkspace",
        "title": "Keystone: Open Workspace",
        "category": "Keystone"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "build:webview": "npm --prefix webview run build",
    "build:extension": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p ./",
    "build": "npm run build:webview && npm run build:extension",
    "verify:package": "node scripts/verify-package.js",
    "package": "npm run build && npm run verify:package && vsce package",
    "install:vscode": "powershell -ExecutionPolicy Bypass -File scripts/install-vscode.ps1",
    "typecheck": "tsc -p ./ && npm --prefix webview run typecheck",
    "test": "npm --prefix webview run test"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.3.0"
  }
}
